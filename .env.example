# Copy this file to .env.local (git-ignored) at the repository root and fill in the values.
# apps/web, apps/worker (Node) and the scripts all read it. Never commit real values.
# In production these go in Vercel's project settings and in Cloudflare secrets instead.

# --- Database -----------------------------------------------------------------
# Local: postgres://haycupo:haycupo@127.0.0.1:5432/haycupo
# Supabase: the pooler URL in transaction mode (port 6543).
DATABASE_URL=
# Optional: direct connection (port 5432) used only to run migrations.
MIGRATION_DATABASE_URL=

# --- Between apps/web and apps/worker ---------------------------------------------
# Where the worker answers. Local: http://127.0.0.1:8787
WORKER_URL=http://127.0.0.1:8787
# Shared secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=

# --- SIIAU access (apps/worker, pnpm capture) -------------------------------------
# Contact address sent in the User-Agent of every request to SIIAU, so the
# university can reach the maintainer if the tool ever causes trouble.
# Required. SIIAU sees it, so use an address you are fine making public.
SIIAU_CONTACT_EMAIL=
# Kill switch: false stops every request to SIIAU.
SIIAU_ENABLED=true
# Minimum pause between two requests to SIIAU, in milliseconds (never below 2000).
SIIAU_MIN_DELAY_MS=3000
# How long a search waits for its turn before answering "busy" (ms).
SIIAU_MAX_WAIT_MS=20000
# How long a search result is reused before asking SIIAU again (seconds, min 60).
SEARCH_CACHE_TTL_SECONDS=300
# Local development and tests only: send SIIAU requests to the fake SIIAU
# (pnpm --filter @haycupo/fake-siiau start). Leave empty in production.
SIIAU_ORIGIN_OVERRIDE=http://127.0.0.1:8788
