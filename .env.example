# Local development: copy this file to .env.local (git-ignored) at the repository root.
# Production on Netlify: set the variables in Site configuration -> Environment variables
# (docs/deploy.md lists which ones) and redeploy after every change.
# Optional VM (docs/deploy.md, "Más capacidad"): copy it to .env next to compose.yaml
# (also git-ignored). Never commit real values.

# --- Database (Turso / libSQL) --------------------------------------------------------
# Local: a SQLite file, no account needed (the folder is created for you).
# Production: libsql://<database>-<organization>.turso.io
TURSO_DATABASE_URL=file:../../data/local.db
# Production only: `turso db tokens create <database>`.
TURSO_AUTH_TOKEN=
# Apply pending migrations when the server starts (before it takes requests).
# Not used on Netlify: the Deploy workflow migrates.
MIGRATE_ON_START=true

# --- The site ---------------------------------------------------------------------------
# Public URL, used in links inside messages. On Netlify it defaults to the site's URL.
APP_URL=http://127.0.0.1:3000
# Signs "cancel this alert" links. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Protects /api/internal/* (manual poll, emergency brake). At least 32 characters.
INTERNAL_API_TOKEN=
# VM only (compose.yaml requires it): the domain Caddy gets an HTTPS certificate for.
SITE_DOMAIN=

# --- Email (sign-in links and alerts) ---------------------------------------------------
# resend (production), file (end-to-end tests) or log (prints to the console).
EMAIL_TRANSPORT=log
RESEND_API_KEY=
# Resend only delivers to anyone from a verified domain, e.g. "¿Hay Cupo? <avisos@tudominio.com>".
EMAIL_FROM=
EMAIL_FILE_DIR=
# Resend's free plan: 100 emails a day. Keep some margin.
EMAIL_DAILY_LIMIT=90

# --- Telegram (optional; see docs/telegram.md) -----------------------------------------
# From @BotFather. Without a token, the Telegram channel is off.
TELEGRAM_BOT_TOKEN=
# The bot's username without the @, for the "Conectar Telegram" button.
TELEGRAM_BOT_USERNAME=
# Telegram sends it with every update so the server knows the call is real.
# 16-256 characters: A-Z a-z 0-9 _ -  Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=
# Tests only: a fake Bot API instead of https://api.telegram.org. Leave empty.
TELEGRAM_API_ORIGIN=

# --- Browser notifications, Web Push (optional) ----------------------------------------
# Generate the pair once with: pnpm --filter @haycupo/notify vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# How push services can reach you. Defaults to mailto:<SIIAU_CONTACT_EMAIL>.
VAPID_SUBJECT=

# --- SIIAU access -------------------------------------------------------------------
# Contact address sent in the User-Agent of every request to SIIAU, so the
# university can reach the maintainer if the tool ever causes trouble.
# Required. SIIAU sees it, and the privacy and about pages show it.
SIIAU_CONTACT_EMAIL=
# Kill switch: false stops every request to SIIAU.
SIIAU_ENABLED=true
# Minimum pause between two requests to SIIAU, in milliseconds (never below 2000).
SIIAU_MIN_DELAY_MS=3000
# How long a search waits for its turn before answering "busy", and how long one request
# to SIIAU may take (ms). Empty means 20000 each; on Netlify, 2500 and 5500, so a page fits
# in its 10 seconds (keep their sum under ~9000 there).
SIIAU_MAX_WAIT_MS=
SIIAU_TIMEOUT_MS=
# How long a search result is reused before asking SIIAU again (seconds, min 60).
SEARCH_CACHE_TTL_SECONDS=300
# Local development and tests only: send SIIAU requests to the fake SIIAU
# (pnpm --filter @haycupo/fake-siiau start). Leave empty in production.
SIIAU_ORIGIN_OVERRIDE=http://127.0.0.1:8788

# --- Polling --------------------------------------------------------------------------
# Poll SIIAU every minute: inside the server, or in the scheduled function on Netlify.
# false turns that off (tests poll on demand; Netlify when a VM polls instead).
SCHEDULER_ENABLED=true
# Every interval has a floor that cannot be configured away (see packages/engine/src/config.ts).
POLL_INTERVAL_SECONDS=300
POLL_REGISTRATION_INTERVAL_SECONDS=120
POLL_UNPUBLISHED_INTERVAL_SECONDS=3600
# Subjects per run. On Netlify the default is 1, so a run never waits the pause between requests.
POLL_MAX_SUBJECTS_PER_RUN=15
NOTIFY_COOLDOWN_MINUTES=30
