# Copy this file to .env.local (git-ignored) and fill in the values.
# Never commit real values.

# --- SIIAU access -----------------------------------------------------------
# Contact address sent in the User-Agent of every request to SIIAU, so the
# university can reach the maintainer if the tool ever causes trouble.
# Required. SIIAU sees it, so use an address you are fine making public.
SIIAU_CONTACT_EMAIL=

# Minimum pause between two requests to SIIAU, in milliseconds.
# Optional. Defaults to 3000; values below 2000 are rejected.
SIIAU_MIN_DELAY_MS=3000
