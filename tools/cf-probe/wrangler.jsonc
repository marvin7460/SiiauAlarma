{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "haycupo-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // Secrets, set with `pnpm wrangler secret put <NAME>` (never in this file):
  // - PROBE_KEY: random string required in ?key= so strangers cannot trigger requests to SIIAU.
  // - SIIAU_CONTACT_EMAIL: contact address for the User-Agent.
}
